---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Lucas Horsman">
  <main class="not-found-page">
    <div class="container">
      <div class="glass-panel not-found-card">
        <div class="ocean-bubble-icon" aria-hidden="true">🌊</div>
        <span class="error-code">404</span>
        <h1 class="error-title">Drifted Into Deep Waters</h1>
        <p class="error-text">
          The page or essay you are looking for has been moved, renamed, or washed out to sea.
        </p>
        <div class="cta-actions">
          <a href="/" class="btn btn-primary">Return Home</a>
          <a href="/projects/" class="btn btn-secondary">Explore Projects</a>
          <a href="/essays/" class="btn btn-secondary">Read Essays</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-card {
    text-align: center;
    padding: 4.5rem 2rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .ocean-bubble-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    animation: float-wave 3s infinite ease-in-out alternate;
  }

  @keyframes float-wave {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-10px) rotate(6deg); }
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .error-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
